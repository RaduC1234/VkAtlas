#version 450

// Simple sphere-based frustum culling compute shader
// Bindings:
// 0: uniform CameraUBO { mat4 view; mat4 proj; vec4 params; } - params.x = instance count
// 1: ssbo Spheres { vec4 spheres[]; } - each vec4 is (center.xyz, radius)
// 2: ssbo Visible { uint visible[]; } - output flags (1 = visible, 0 = culled)

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std140, binding = 0) uniform CameraUBO {
    mat4 view;
    mat4 proj;
    vec4 params; // params.x = instanceCount
};

layout(std430, binding = 1) buffer Spheres {
    vec4 spheres[]; // (cx, cy, cz, radius)
};

layout(std430, binding = 2) buffer Visible {
    uint visible[];
};

// Extract and normalize clip-space frustum planes from projection * view matrix
void extractFrustumPlanes(mat4 vp, out vec4 planes[6]) {
    // left, right, bottom, top, near, far
    planes[0] = vp[3] + vp[0]; // left
    planes[1] = vp[3] - vp[0]; // right
    planes[2] = vp[3] + vp[1]; // bottom
    planes[3] = vp[3] - vp[1]; // top
    planes[4] = vp[3] + vp[2]; // near
    planes[5] = vp[3] - vp[2]; // far

    // Normalize planes
    for (int i = 0; i < 6; ++i) {
        float len = length(planes[i].xyz);
        if (len > 0.0) {
            planes[i] /= len;
        }
    }
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint instanceCount = uint(params.x);
    if (idx >= instanceCount) return;

    // Load sphere
    vec4 s = spheres[idx];
    vec3 center = s.xyz;
    float radius = s.w;

    // Prepare frustum planes
    mat4 vp = proj * view;
    vec4 planes[6];
    extractFrustumPlanes(vp, planes);

    // Default to visible
    uint isVisible = 1u;

    // Sphere-frustum test: if completely outside any plane -> culled
    for (int i = 0; i < 6; ++i) {
        float distance = dot(planes[i].xyz, center) + planes[i].w;
        if (distance < -radius) {
            isVisible = 0u;
            break;
        }
    }

    visible[idx] = isVisible;
}
