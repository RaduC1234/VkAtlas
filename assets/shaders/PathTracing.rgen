#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_nonuniform_qualifier : require

// ---- Structs ----

struct CameraData {
    mat4 projection;
    mat4 view;
    mat4 viewProjection;
    vec4 frustumPlanes[6];
    vec3 position;
    float nearPlane;
    vec3 direction;
    float farPlane;
};

struct DebugData {
    float iblMultiplier;
    float exposureMultiplier;
    uint viewMode;
};

struct RayPayload {
    vec3  radiance;
    vec3  throughput;
    vec3  origin;
    vec3  direction;
    bool  done;
    uint  seed;
};

// ---- Descriptors ----

layout(set = 0, binding = 0) uniform GlobalUbo {
    CameraData cameraData;
    DebugData  debugData;
} ubo;

layout(set = 1, binding = 0, rgba32f) uniform image2D outputImage;
layout(set = 1, binding = 1)          uniform accelerationStructureEXT tlas;
layout(set = 1, binding = 7, rgba32f) uniform image2D accumulationImage;

// ---- Push constants ----

layout(push_constant) uniform PushConstants {
    uint sampleIndex;
    uint maxBounces;
    uint frameIndex;
    uint lightCount;
} pc;

// ---- RNG — PCG hash ----

uint pcgHash(uint seed) {
    uint state = seed * 747796405u + 2891336453u;
    uint word  = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float randFloat(inout uint seed) {
    seed = pcgHash(seed);
    return float(seed) / float(0xFFFFFFFFu);
}

vec2 randVec2(inout uint seed) {
    return vec2(randFloat(seed), randFloat(seed));
}

bool hasInvalid(float v) {
    return isnan(v) || isinf(v);
}

bool hasInvalid(vec3 v) {
    return any(isnan(v)) || any(isinf(v));
}

vec3 sanitizeColor(vec3 color, vec3 fallback) {
    if (hasInvalid(color)) return fallback;
    return clamp(color, vec3(0.0), vec3(1.0e6));
}

// ---- Display transform ----

vec3 ACESFitted(vec3 color) {
    const mat3 inputMat = mat3(
        0.59719, 0.07600, 0.02840,
        0.35458, 0.90834, 0.13383,
        0.04823, 0.01566, 0.83777
    );
    const mat3 outputMat = mat3(
         1.60475, -0.10208, -0.00327,
        -0.53108,  1.10813, -0.07276,
        -0.07367, -0.00605,  1.07602
    );

    color = inputMat * color;
    vec3 a = color * (color + 0.0245786) - 0.000090537;
    vec3 b = color * (0.983729 * color + 0.4329510) + 0.238081;
    return clamp(outputMat * (a / b), 0.0, 1.0);
}

// ---- Payload location ----

layout(location = 0) rayPayloadEXT RayPayload payload;

void main() {
    const ivec2 pixel     = ivec2(gl_LaunchIDEXT.xy);
    const ivec2 imageSize = ivec2(gl_LaunchSizeEXT.xy);

    // Seed: hash each dimension separately to reduce visible pixel/sample patterns.
    uint pixelIndex = uint(pixel.x + pixel.y * imageSize.x);
    uint seed = pcgHash(pixelIndex)
              ^ pcgHash(pc.sampleIndex + 0x9E3779B9u)
              ^ pcgHash(pc.frameIndex  + 0xBB67AE85u);

    // Jittered subpixel offset for anti-aliasing
    vec2 jitter = randVec2(seed) - 0.5;
    vec2 uv     = (vec2(pixel) + 0.5 + jitter) / vec2(imageSize);
    uv          = uv * 2.0 - 1.0;

    // Reconstruct ray from camera matrices
    vec4 origin    = inverse(ubo.cameraData.view) * vec4(0, 0, 0, 1);
    vec4 target    = inverse(ubo.cameraData.projection) * vec4(uv, 1, 1);
    vec4 direction = inverse(ubo.cameraData.view) * vec4(normalize(target.xyz), 0);

    payload.radiance   = vec3(0.0);
    payload.throughput = vec3(1.0);
    payload.origin     = origin.xyz;
    payload.direction  = normalize(direction.xyz);
    payload.done       = false;
    payload.seed       = seed;

    // Path trace — up to maxBounces
    for (uint bounce = 0; bounce < pc.maxBounces; bounce++) {
        traceRayEXT(
            tlas,
            gl_RayFlagsNoneEXT,
            0xFF,           // cull mask
            0,              // sbt record offset — hit group 0
            0,              // sbt record stride
            0,              // miss index
            payload.origin,
            0.001,          // tMin
            payload.direction,
            10000.0,        // tMax
            0               // payload location
        );

        if (payload.done) break;
    }

    // Accumulate in HDR, then write a separate tone-mapped image for display.
    vec3 sampleRadiance = sanitizeColor(payload.radiance, vec3(0.0));
    vec3 accumulated;
    if (pc.sampleIndex == 0u) {
        accumulated = sampleRadiance;
    } else {
        vec3 prev = sanitizeColor(imageLoad(accumulationImage, pixel).rgb, vec3(0.0));
        accumulated = mix(prev, sampleRadiance, 1.0 / float(pc.sampleIndex + 1u));
    }
    accumulated = sanitizeColor(accumulated, sampleRadiance);

    imageStore(accumulationImage, pixel, vec4(accumulated, 1.0));

    vec3 display = ACESFitted(max(accumulated, vec3(0.0)) * ubo.debugData.exposureMultiplier);
    imageStore(outputImage, pixel, vec4(display, 1.0));
}
